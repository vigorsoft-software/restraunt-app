
{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A food or drink item on the menu",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "imageUrl": { "type": "string" },
        "ingredients": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["name", "price", "category"]
    },
    "Category": {
      "title": "Category",
      "description": "A menu category (e.g., Starters, Mains)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" },
        "imageUrl": { "type": "string" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "mobileNumber": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "completed", "delivered"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "mobileNumber", "items", "totalAmount", "status"]
    },
    "User": {
      "title": "User",
      "description": "A customer or admin user with authentication details",
      "type": "object",
      "properties": {
        "mobileNumber": { "type": "string", "description": "Acts as the unique identifier and document ID" },
        "name": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "password": { "type": "string", "description": "Stored as plain-text for prototype simplicity" },
        "lastOrderedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["mobileNumber", "name", "isAdmin"]
    },
    "Notification": {
      "title": "Notification",
      "description": "In-app notification for users and admins",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string", "description": "Mobile number or 'admin'" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "title", "message", "read"]
    }
  },
  "auth": {
    "providers": ["google.com"]
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "#/backend/entities/Product",
      "description": "Collection of menu items"
    },
    "/categories/{categoryId}": {
      "schema": "#/backend/entities/Category",
      "description": "Collection of menu categories"
    },
    "/orders/{orderId}": {
      "schema": "#/backend/entities/Order",
      "description": "Collection of customer orders"
    },
    "/users/{mobileNumber}": {
      "schema": "#/backend/entities/User",
      "description": "Collection of users and admins identified by mobile number"
    },
    "/notifications/{notificationId}": {
      "schema": "#/backend/entities/Notification",
      "description": "Real-time notifications for status updates and new orders"
    }
  }
}
